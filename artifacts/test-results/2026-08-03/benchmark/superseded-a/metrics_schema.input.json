{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "orchestra.paper_cpu.metrics/v2",
  "title": "ORCHESTRA paper CPU userspace metrics CSV v2",
  "format": "csv",
  "q_definition": "Q=(S1*S2*S3*S4)^(1/4); if any factor is zero, Q is exactly zero",
  "q_absolute_tolerance": 1e-7,
  "columns": [
    {"name": "tick", "type": "integer", "minimum": 1},
    {"name": "mode", "type": "string", "enum": ["baseline", "orchestra"]},
    {"name": "cpu_now", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "cpu_pred", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "decision_cpu", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "prediction_used", "type": "boolean01"},
    {"name": "confidence", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "forecast_error", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "frame_age_ms", "type": "number", "minimum": 0},
    {"name": "mem", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "thermal", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "directive", "type": "string", "enum": ["RUN", "SLEEP", "MIGRATE", "THROTTLE", "YIELD"]},
    {"name": "run", "type": "integer", "minimum": 0},
    {"name": "sleep", "type": "integer", "minimum": 0},
    {"name": "migrate", "type": "integer", "minimum": 0},
    {"name": "throttle", "type": "integer", "minimum": 0},
    {"name": "yield", "type": "integer", "minimum": 0},
    {"name": "eligible_workers", "type": "integer", "minimum": 0},
    {"name": "fallback_workers", "type": "integer", "minimum": 0},
    {"name": "S1", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "S2", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "S3", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "S4", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "Q", "type": "number", "minimum": 0, "maximum": 1},
    {"name": "jitter_sigma", "type": "number", "minimum": 0, "maximum": 0.2},
    {"name": "switch_penalty", "type": "number", "minimum": 0, "maximum": 0.3},
    {"name": "consensus_blend", "type": "number", "minimum": 0, "maximum": 0.15},
    {"name": "next_jitter_sigma", "type": "number", "minimum": 0, "maximum": 0.2},
    {"name": "next_switch_penalty", "type": "number", "minimum": 0, "maximum": 0.3},
    {"name": "next_consensus_blend", "type": "number", "minimum": 0, "maximum": 0.15},
    {"name": "controller_updated", "type": "boolean01"},
    {"name": "controller_step", "type": "integer", "minimum": 0},
    {"name": "controller_reason", "type": "string", "enum": ["NONE", "S3", "S4", "S3+S4"]},
    {"name": "controller_beta", "type": "number", "minimum": 0, "maximum": 0.02},
    {"name": "jitter_saturated", "type": "boolean01"},
    {"name": "switch_saturated", "type": "boolean01"},
    {"name": "consensus_saturated", "type": "boolean01"},
    {"name": "consensus_applied", "type": "boolean01"},
    {"name": "rejected_frames", "type": "integer", "minimum": 0},
    {"name": "missed_deadlines", "type": "integer", "minimum": 0}
  ]
}
