    "action_error_count": "Sum of published current-window error counts after warm-up, not a deduplicated kernel error-event trace.",
    "claim_limitation": "All effective-action statistics are observable userspace operation outcomes, not Linux scheduler compliance or scheduler-performance evidence.",
    "fractions": "Per-action effectiveness fractions are recomputed from summed current-window success and attempt counters within each invocation; rows are not treated as independent repetitions.",
    "statistical_unit": "one validated invocation after declared warm-up"
  },
